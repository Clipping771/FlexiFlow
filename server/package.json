{
  "name": "lexiflow-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lexiflow --local",
    "db:migrate:remote": "wrangler d1 migrations apply lexiflow --remote",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "test": "vitest run",
    "ci": "npm run typecheck && npm test",
    "report:costs": "node scripts/cost-report.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^22.20.5",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.15.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
